# Public origin of the live site. Used for canonical URLs, Open Graph, structured data and sitemap.xml.
# CONFIRM the production domain (dadasons.org is the address printed on the business card).
VITE_SITE_URL=https://dadasons.org

# Optional. POST endpoint for the contact form (e.g. a Formspree form URL or your own API).
# Leave empty and the form falls back to opening the visitor's email app — nothing is sent by the site.
VITE_ENQUIRY_ENDPOINT=
